# Variables del stack de producción (docker-compose.prod.yml). Se copia a `.env` en la instancia; NO se versiona.
# Las genera el despliegue (valores aleatorios); acá solo está la forma.

# Imágenes (ECR)
ECR_REGISTRY=<cuenta>.dkr.ecr.sa-east-1.amazonaws.com
IMAGE_TAG=latest
AWS_REGION=sa-east-1

# Base de datos
POSTGRES_DB=comedor_uagrm_db
POSTGRES_USER=comedor_uagrm_admin
POSTGRES_PASSWORD=

# Sesión: mínimo 32 caracteres
JWT_SECRET=

# Dirección pública (https://<dominio>.cloudfront.net): enlaces de los correos y CORS
FRONTEND_URL=

# Archivos: S3 con el rol de la instancia. Si el rol no se puede usar, STORAGE_CREDENTIALS=static + claves.
STORAGE_BUCKET=
STORAGE_CREDENTIALS=aws-iam
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Correo (SES por SMTP)
MAIL_HOST=email-smtp.sa-east-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Cuentas de demostración (todas comparten esta contraseña)
SEED_ADMIN_CORREO=admin@dubss.com
DEMO_PASSWORD=
