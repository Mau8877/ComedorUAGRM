meta {
  name: Resumen de reprocesamiento (E02)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/convocatorias/{{cE02}}/resumen-reprocesamiento
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.data.calificadas: isNumber
}
