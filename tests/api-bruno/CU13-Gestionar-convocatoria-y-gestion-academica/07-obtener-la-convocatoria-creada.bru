meta {
  name: Obtener la convocatoria creada
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/convocatorias/{{convocatoriaCodigo}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.data.codigo: eq {{convocatoriaCodigo}}
  res.body.data.estado: eq BORRADOR
}
