meta {
  name: Listar tipos de documento
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/tipos-documento
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

script:post-response {
  bru.setVar("tipoDocCodigo", res.body.data[0].codigo);
}

assert {
  res.status: eq 200
  res.body.status: eq success
}
