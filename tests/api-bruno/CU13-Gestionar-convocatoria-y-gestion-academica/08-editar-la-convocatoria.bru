meta {
  name: Editar la convocatoria
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/v1/convocatorias/{{convocatoriaCodigo}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "nombre": "Convocatoria automatizada {{etiquetaGestion}}",
    "gestionCodigo": "{{gestionCodigo}}",
    "fechaApertura": "{{apertura}}",
    "fechaCierre": "{{cierre}}",
    "cupos": 60,
    "puntajeMinimo": 40,
    "cantidadFinalistas": 60,
    "documentos": [
      {
        "tipoDocumentoCodigo": "{{tipoDocCodigo}}",
        "obligatorio": true
      }
    ]
  }
}

script:pre-request {
  const h = new Date();
  bru.setVar("apertura", h.toISOString().slice(0, 10));
  bru.setVar("cierre", new Date(h.getTime() + 30 * 864e5).toISOString().slice(0, 10));
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.data.cupos: eq 60
}
