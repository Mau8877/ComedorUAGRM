meta {
  name: Publicar un comunicado general
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/comunicados
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "titulo": "Aviso de prueba automatizada",
    "contenido": "Contenido del aviso",
    "destinatarios": "TODOS"
  }
}

assert {
  res.status: eq 201
  res.body.status: eq success
}
