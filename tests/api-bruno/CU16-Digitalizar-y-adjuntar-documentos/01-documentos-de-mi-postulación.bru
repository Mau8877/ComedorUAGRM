meta {
  name: Documentos de mi postulación
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/postulaciones/{{postulacionCodigo}}/documentos
  body: none
  auth: bearer
}

auth:bearer {
  token: {{postToken}}
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.data.reglas.tamanoMaximoBytes: eq 5242880
  res.body.data.requeridos: isDefined
}
