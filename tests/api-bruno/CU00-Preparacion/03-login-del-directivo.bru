meta {
  name: Login del directivo
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correo": "directivo@dubss.com",
    "contrasena": "{{adminPassword}}"
  }
}

script:post-response {
  bru.setVar("directivoToken", res.body.data.accessToken);
}

assert {
  res.status: eq 200
  res.body.status: eq success
}
