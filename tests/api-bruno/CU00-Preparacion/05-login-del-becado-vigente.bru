meta {
  name: Login del becado vigente
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correo": "becado.vigente@prueba.local",
    "contrasena": "{{adminPassword}}"
  }
}

script:post-response {
  bru.setVar("becadoToken", res.body.data.accessToken);
}

assert {
  res.status: eq 200
  res.body.status: eq success
}
