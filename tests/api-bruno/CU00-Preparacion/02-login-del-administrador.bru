meta {
  name: Login del administrador
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correo": "{{adminCorreo}}",
    "contrasena": "{{adminPassword}}"
  }
}

script:post-response {
  bru.setVar("adminToken", res.body.data.accessToken);
}

assert {
  res.status: eq 200
  res.body.status: eq success
}
