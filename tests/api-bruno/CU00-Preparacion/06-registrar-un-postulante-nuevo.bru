meta {
  name: Registrar un postulante nuevo
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/registro
  body: json
  auth: none
}

body:json {
  {
    "nombres": "Prueba",
    "apellidos": "Automatica",
    "ci": "{{ci}}",
    "registroUniversitario": "{{ru}}",
    "carreraCodigo": "{{carreraCodigo}}",
    "telefono": "70000000",
    "correo": "{{correoPost}}",
    "contrasena": "Clave123",
    "confirmacionContrasena": "Clave123"
  }
}

script:pre-request {
  const n = Date.now();
  bru.setVar("ci", String(n).slice(-8));
  bru.setVar("ru", "2" + String(n).slice(-8));
  bru.setVar("correoPost", `post${n}@prueba.test`);
}

script:post-response {
  bru.setVar("postToken", res.body.data.accessToken);
  bru.setVar("postRefresh", res.body.data.refreshToken);
}

assert {
  res.status: eq 201
  res.body.status: eq success
}
