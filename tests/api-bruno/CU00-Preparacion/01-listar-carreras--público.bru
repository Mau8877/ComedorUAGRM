meta {
  name: Listar carreras (público)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/carreras
  body: none
  auth: none
}

script:post-response {
  try { const v = res.body.data[0].codigo; if (v !== undefined) bru.setVar("carreraCodigo", v); } catch (e) {}
}

assert {
  res.status: eq 200
  res.body.status: eq success
}
