meta {
  name: Cambiar el teléfono del perfil
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/v1/perfil
  body: json
  auth: bearer
}

auth:bearer {
  token: {{postToken}}
}

body:json {
  {
    "telefono": "71111111",
    "contrasenaActual": "Clave123"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq success
}
