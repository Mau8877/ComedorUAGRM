meta {
  name: Cambiar contraseña correctamente
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/cambiar-contrasena
  body: json
  auth: bearer
}

auth:bearer {
  token: {{postToken}}
}

body:json {
  {
    "contrasenaActual": "Clave123",
    "contrasenaNueva": "Clave1234",
    "confirmacionContrasena": "Clave1234"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq success
}
