meta {
  name: Restablecer con un enlace inválido (400)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/restablecer-contrasena
  body: json
  auth: none
}

body:json {
  {
    "token": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
    "contrasena": "Clave1234",
    "confirmacionContrasena": "Clave1234"
  }
}

assert {
  res.status: eq 400
  res.body.status: eq failed
  res.body.error: eq ERR_AUTH_08
}
