meta {
  name: Detalle de mi postulación
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/postulaciones/{{postulacionCodigo}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{postToken}}
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.data.codigo: eq {{postulacionCodigo}}
}
