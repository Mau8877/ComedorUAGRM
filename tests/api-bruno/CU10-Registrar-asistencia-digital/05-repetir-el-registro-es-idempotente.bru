meta {
  name: Repetir el registro es idempotente
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/asistencias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{personalToken}}
}

body:json {
  {
    "becaCodigo": "{{becaE08}}"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.data.yaRegistrada: eq true
}
