meta {
  name: Buscar becado por CI
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/asistencias/buscar-becado
  body: json
  auth: bearer
}

auth:bearer {
  token: {{personalToken}}
}

body:json {
  {
    "ci": "{{ciE08}}"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.data.becaCodigo: eq {{becaE08}}
}
