meta {
  name: Adjudicar la beca al finalista 1
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/finalistas/{{e03f1}}/adjudicar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.data.resultado: eq ADJUDICADA
}
