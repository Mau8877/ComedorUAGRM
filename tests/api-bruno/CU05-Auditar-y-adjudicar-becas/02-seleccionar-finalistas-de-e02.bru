meta {
  name: Seleccionar finalistas de E02
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/convocatorias/{{cE02}}/finalistas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "cantidad": 1
  }
}

assert {
  res.status: eq 201
  res.body.status: eq success
  res.body.data.seleccionados: eq 1
}
