meta {
  name: Un postulante no puede adjudicar (403)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/finalistas/{{e03f4}}/adjudicar
  body: none
  auth: bearer
}

auth:bearer {
  token: {{postToken}}
}

assert {
  res.status: eq 403
  res.body.status: eq failed
  res.body.error: eq ERR_AUTH_07
}
