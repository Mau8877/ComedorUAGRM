meta {
  name: Resumen de adjudicación (E04)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/convocatorias/{{cE04}}/adjudicacion
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.data.cupos: isNumber
}
