meta {
  name: Postulante no accede al panel del administrador (403)
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/panel/administrador
  body: none
  auth: bearer
}

auth:bearer {
  token: {{postToken}}
}

assert {
  res.status: eq 403
  res.body.status: eq failed
  res.body.error: eq ERR_AUTH_07
}
