meta {
  name: Login con credenciales inválidas (401)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correo": "{{adminCorreo}}",
    "contrasena": "incorrecta-000"
  }
}

assert {
  res.status: eq 401
  res.body.status: eq failed
  res.body.error: eq ERR_AUTH_04
}
