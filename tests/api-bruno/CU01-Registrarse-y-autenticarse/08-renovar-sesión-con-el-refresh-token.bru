meta {
  name: Renovar sesión con el refresh token
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{adminRefresh}}"
  }
}

script:post-response {
  bru.setVar("adminToken", res.body.data.accessToken);
  bru.setVar("adminRefresh", res.body.data.refreshToken);
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.data.accessToken: isString
}
