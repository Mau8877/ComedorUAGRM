meta {
  name: Renovar con un refresh token ya usado (401)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "token-que-no-existe"
  }
}

assert {
  res.status: eq 401
  res.body.status: eq failed
  res.body.error: eq ERR_AUTH_06
}
