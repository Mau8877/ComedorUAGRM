meta {
  name: Login con correo inexistente (401, mismo mensaje)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correo": "no.existe@prueba.test",
    "contrasena": "incorrecta-000"
  }
}

assert {
  res.status: eq 401
  res.body.status: eq failed
  res.body.error: eq ERR_AUTH_04
}
