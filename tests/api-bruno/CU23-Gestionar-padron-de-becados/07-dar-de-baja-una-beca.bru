meta {
  name: Dar de baja una beca
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/becas/{{becaBaja}}/dar-de-baja
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "motivo": "Prueba automatizada"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.data.estado: eq BAJA
}
