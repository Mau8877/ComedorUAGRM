meta {
  name: Resumen del padrón (E07)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/convocatorias/{{cE07}}/padron/resumen
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.data.vigentes: gte 1
}
