meta {
  name: Dar de alta a los adjudicados de E06
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/convocatorias/{{cE06}}/padron/alta
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 201
  res.body.status: eq success
  res.body.data.creadas: gte 1
}
