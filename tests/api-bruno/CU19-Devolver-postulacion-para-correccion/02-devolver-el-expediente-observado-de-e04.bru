meta {
  name: Devolver el expediente observado de E04
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/finalistas/{{e04Observado}}/devolver
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "motivo": "Falta una fotocopia del carnet"
  }
}

tests {
    test("devuelta o ya devuelta", function () {
      expect([200, 409]).to.include(res.status);
    });
}
