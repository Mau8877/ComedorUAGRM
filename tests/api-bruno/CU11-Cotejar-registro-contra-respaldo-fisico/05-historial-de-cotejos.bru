meta {
  name: Historial de cotejos
  type: http
  seq: 5
  tags: [
    minio
  ]
}

get {
  url: {{baseUrl}}/api/v1/planillas/{{planillaCodigo}}/cotejos?page=1&pageSize=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 200
  res.body.status: eq success
}
