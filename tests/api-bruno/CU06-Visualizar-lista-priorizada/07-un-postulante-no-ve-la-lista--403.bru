meta {
  name: Un postulante no ve la lista (403)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/lista-priorizada?filter%5BconvocatoriaId%5D={{cE02}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{postToken}}
}

assert {
  res.status: eq 403
  res.body.status: eq failed
  res.body.error: eq ERR_AUTH_07
}
