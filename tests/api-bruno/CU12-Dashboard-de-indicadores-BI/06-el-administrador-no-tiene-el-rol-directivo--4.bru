meta {
  name: El administrador no tiene el rol Directivo (403)
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/dashboard/indicadores
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 403
  res.body.status: eq failed
  res.body.error: eq ERR_AUTH_07
}
