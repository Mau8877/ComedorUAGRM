meta {
  name: Finalistas de E04
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/finalistas?filter%5BconvocatoriaId%5D={{cE04}}&pageSize=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

script:post-response {
  const d = res.body.data;
  bru.setVar("e04Validado", d.find(x => x.resultadoAuditoria === "VALIDADO").codigo);
  bru.setVar("e04Observado", d.find(x => x.resultadoAuditoria === "OBSERVADO").codigo);
  bru.setVar("e04SinAuditar", d.find(x => x.resultadoAuditoria === "SIN_AUDITAR").codigo);
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.data.length: eq 4
}
