meta {
  name: Editar los datos de la cuenta
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/usuarios/{{usuarioNuevo}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "nombres": "Nuevo2",
    "apellidos": "Personal",
    "correo": "{{correoNuevo}}"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.data.nombres: eq Nuevo2
}
