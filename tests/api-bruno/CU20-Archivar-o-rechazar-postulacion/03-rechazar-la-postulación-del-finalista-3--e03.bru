meta {
  name: Rechazar la postulación del finalista 3 (E03)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/finalistas/{{e03f3}}/rechazar
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "motivo": "No cumple requisitos"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.data.estado: isString
}
