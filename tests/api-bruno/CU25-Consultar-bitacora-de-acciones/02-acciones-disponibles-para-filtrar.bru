meta {
  name: Acciones disponibles para filtrar
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/bitacora/acciones
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

script:post-response {
  bru.setVar("accionBitacora", res.body.data[0]);
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.data.length: gte 1
}
