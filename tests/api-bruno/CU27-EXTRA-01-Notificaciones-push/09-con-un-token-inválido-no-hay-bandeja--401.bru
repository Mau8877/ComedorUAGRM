meta {
  name: Con un token inválido no hay bandeja (401)
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/notificaciones/me
  body: none
  auth: none
}

script:pre-request {
  req.setHeader("Authorization", "Bearer token.invalido.000");
}

assert {
  res.status: eq 401
  res.body.status: eq failed
  res.body.error: eq ERR_AUTH_01
}
