meta {
  name: Registrar un dispositivo para el push
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/dispositivos-fcm
  body: json
  auth: bearer
}

auth:bearer {
  token: {{becadoToken}}
}

body:json {
  {
    "token": "token-de-prueba-automatizada-0123456789",
    "plataforma": "ANDROID"
  }
}

assert {
  res.status: eq 201
  res.body.status: eq success
}
