meta {
  name: Ubicar una postulación calificada (E02)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/lista-priorizada?filter%5BconvocatoriaId%5D={{cE02}}&pageSize=3
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

script:post-response {
  try { const v = res.body.data[0].codigo; if (v !== undefined) bru.setVar("calificadaCodigo", v); } catch (e) {}
}

assert {
  res.status: eq 200
  res.body.status: eq success
}
