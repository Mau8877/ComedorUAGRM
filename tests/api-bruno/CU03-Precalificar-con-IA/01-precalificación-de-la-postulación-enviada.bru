meta {
  name: Precalificación de la postulación enviada
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/postulaciones/{{postulacionCodigo}}/precalificacion
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.data.estado: isString
}
