meta {
  name: Precalificación con puntaje y variables
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/postulaciones/{{calificadaCodigo}}/precalificacion
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 200
  res.body.status: eq success
  res.body.data.estado: eq calificada
}

tests {
    test("el puntaje no pasa de 70", function () {
      expect(res.body.data.puntaje).to.be.at.most(70);
    });
}
