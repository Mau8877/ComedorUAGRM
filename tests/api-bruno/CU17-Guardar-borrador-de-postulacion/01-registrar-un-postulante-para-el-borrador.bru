meta {
  name: Registrar un postulante para el borrador
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/registro
  body: json
  auth: none
}

body:json {
  {
    "nombres": "Borrador",
    "apellidos": "Prueba",
    "ci": "{{ciB}}",
    "registroUniversitario": "{{ruB}}",
    "carreraCodigo": "{{carreraCodigo}}",
    "telefono": "70000001",
    "correo": "{{correoB}}",
    "contrasena": "Clave123",
    "confirmacionContrasena": "Clave123"
  }
}

script:pre-request {
  const n = Date.now() + 7;
  bru.setVar("ciB", String(n).slice(-8));
  bru.setVar("ruB", "3" + String(n).slice(-8));
  bru.setVar("correoB", `borrador${n}@prueba.test`);
}

script:post-response {
  bru.setVar("borradorToken", res.body.data.accessToken);
}

assert {
  res.status: eq 201
  res.body.status: eq success
}
