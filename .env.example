# ==========================================
# INFRAESTRUCTURA GLOBAL
# ==========================================

# ---------------------------------------
# POSTGRESQL
# ---------------------------------------
POSTGRES_DB=comedor_uagrm_db
POSTGRES_USER=comedor_uagrm_admin
POSTGRES_PASSWORD=comedor_uagrm_local_pass_123

# ---------------------------------------
# MINIO (S3 Local)
# ---------------------------------------
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_local_pass_123

# ---------------------------------------
# AUTENTICACIÓN (JWT propio del backend)
# ---------------------------------------
# Secreto de firma de los tokens (HS256): obligatorio, mínimo 32 caracteres.
# Generar uno con:  openssl rand -base64 48
JWT_SECRET=
# true cuando se sirva por HTTPS (producción): marca las cookies de sesión como Secure.
COOKIE_SECURE=false

# ---------------------------------------
# CORREO (recuperación de contraseña)
# ---------------------------------------
# En desarrollo los correos caen en Mailpit (servicio `mailpit` del docker-compose):
# bandeja web en http://localhost:8025, no se entrega nada a personas reales.
# Con los valores por defecto no hace falta definir nada.
# En producción se cambian a los de un proveedor SMTP real, sin tocar código:
#   MAIL_HOST=smtp.proveedor.com
#   MAIL_PORT=587
#   MAIL_USERNAME=usuario
#   MAIL_PASSWORD=clave
#   MAIL_SMTP_AUTH=true
#   MAIL_SMTP_STARTTLS=true
#   MAIL_FROM=no-responder@dominio.edu.bo
#   FRONTEND_URL=https://dominio.edu.bo   (el enlace del correo abre el portal web)
# MAIL_HOST=comedor-uagrm-mailpit
# MAIL_PORT=1025
# MAIL_SMTP_AUTH=false
# MAIL_SMTP_STARTTLS=false
# MAIL_FROM=no-responder@comedoru.local
# FRONTEND_URL=http://localhost
