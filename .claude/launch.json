{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "./projects/frontend", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd projects\\mobile && flutter run -d web-server --web-hostname=0.0.0.0 --web-port=5500"
      ],
      "port": 5500,
      "autoPort": true
    },
    {
      "name": "mobile-web-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-l", "5501", "projects/mobile/build/web"],
      "port": 5501,
      "autoPort": true
    }
  ]
}
