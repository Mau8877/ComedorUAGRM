{
	"name": "comedor-uagrm",
	"private": true,
	"scripts": {
		"prepare": "husky"
	},
	"lint-staged": {
		"projects/frontend/comedoruagrm/**/*.{ts,tsx}": [
			"pnpm --dir projects/frontend/comedoruagrm exec eslint --fix"
		],
		"projects/frontend/nexware-landing/**/*.{ts,astro,mjs,js}": [
			"sh -c 'cd projects/frontend/nexware-landing && npx eslint --fix \"$@\"' _"
		],
		"projects/mobile/**/*.dart": [
			"sh -c 'cd projects/mobile && flutter analyze'"
		],
		"projects/backend/**/*.java": [
			"sh -c 'cd projects/backend && ./mvnw -q checkstyle:check'"
		]
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.4.1"
	}
}
