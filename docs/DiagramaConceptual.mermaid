  ROL {
    bigint id PK
    uuid codigo_rol UK
    varchar nombre UK
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  USUARIO {
    bigint id PK
    uuid codigo_usuario UK
    bigint rol_id FK
    varchar ci UK "(20)"
    varchar correo UK "(150)"
    varchar password_hash "(100)"
    varchar nombres "(100)"
    varchar apellidos "(100)"
    boolean activo
    int intentos_fallidos
    int bloqueos_consecutivos
    timestamptz bloqueado_hasta
    varchar restablecimiento_token_hash UK "(64) nullable"
    timestamptz restablecimiento_expira_en "nullable"
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  SESION {
    bigint id PK
    uuid codigo_sesion UK
    bigint usuario_id FK
    varchar token_hash UK "(64)"
    timestamptz expira_en
    timestamptz revocada_en
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  CARRERA {
    bigint id PK
    uuid codigo_carrera UK
    varchar nombre UK
    varchar facultad
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  POSTULANTE {
    bigint usuario_id PK, FK
    uuid codigo_postulante UK
    bigint carrera_id FK
    varchar registro_universitario UK "(20)"
    varchar telefono "(20)"
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  GESTION_ACADEMICA {
    bigint id PK
    uuid codigo_gestion_academica UK
    varchar etiqueta
    date fecha_inicio
    date fecha_fin
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  CONVOCATORIA {
    bigint id PK
    uuid codigo_convocatoria UK
    bigint gestion_id FK
    bigint creado_por FK
    varchar nombre "(150)"
    timestamptz fecha_apertura
    timestamptz fecha_cierre
    int cupos
    numeric puntaje_minimo "(5,2)"
    estado_convocatoria estado
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  TIPO_DOCUMENTO {
    bigint id PK
    uuid codigo_tipo_documento UK
    varchar nombre
    varchar descripcion
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  CONVOCATORIA_DOCUMENTO {
    bigint convocatoria_id PK, FK
    bigint tipo_documento_id PK, FK
    uuid codigo_convocatoria_documento UK
    boolean obligatorio
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  POSTULACION {
    bigint id PK
    uuid codigo_postulacion UK
    bigint convocatoria_id FK
    bigint postulante_id FK
    estado_postulacion estado
    timestamptz fecha_envio
    smallint numero_envios
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  RESPUESTA_SOCIOECONOMICA {
    bigint postulacion_id PK, FK
    uuid codigo_respuesta_socioeconomica UK
    numeric ingresos_familiares "(12,2)"
    smallint dependientes
    varchar patrimonio "(255)"
    varchar procedencia "(150)"
    numeric promedio_academico "(5,2)"
    varchar estado_vulnerabilidad "(50)"
    jsonb datos_extra
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  NOTA_ACADEMICA {
    bigint id PK
    uuid codigo_nota_academica UK
    bigint postulacion_id FK
    varchar periodo
    numeric promedio
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  DOCUMENTO_ADJUNTO {
    bigint id PK
    uuid codigo_documento_adjunto UK
    bigint postulacion_id FK
    bigint tipo_documento_id FK
    varchar nombre_archivo "(255)"
    varchar mime_type "(100)"
    varchar storage_path "(500)"
    bigint tamano_bytes
    timestamptz subido_en
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  POSTULACION_HISTORIAL {
    bigint id PK
    uuid codigo_postulacion_historial UK
    bigint postulacion_id FK
    bigint usuario_id FK
    estado_postulacion estado_anterior
    estado_postulacion estado_nuevo
    text motivo
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  MODELO_PRESELECCION {
    bigint id PK
    uuid codigo_modelo_preseleccion UK
    bigint creado_por FK
    varchar version
    varchar descripcion
    boolean activo
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  PARAMETRO_MODELO {
    bigint id PK
    uuid codigo_parametro_modelo UK
    bigint modelo_id FK
    varchar clave
    jsonb valor
    numeric ponderacion
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  PUNTAJE_POSTULACION {
    bigint id PK
    uuid codigo_puntaje_postulacion UK
    bigint modelo_id FK
    bigint postulacion_id FK
    numeric puntaje_total "(5,2) CHECK 0-70, la IA califica hasta 70"
    jsonb detalle
    timestamptz fecha_calculo
    boolean vigente
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  LOTE_REPROCESAMIENTO {
    bigint id PK
    uuid codigo_lote_reprocesamiento UK
    bigint convocatoria_id FK
    bigint modelo_id FK
    bigint solicitado_por FK
    varchar estado
    int total_postulaciones
    timestamptz iniciado_en
    timestamptz terminado_en
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  FINALISTA {
    bigint id PK
    uuid codigo_finalista UK
    bigint postulacion_id FK, UK
    int posicion
    date plazo_entrega
    timestamptz notificado_en
    timestamptz documentacion_recibida_en
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  AUDITORIA_EXPEDIENTE {
    bigint id PK
    uuid codigo_auditoria_expediente UK
    bigint finalista_id FK
    bigint auditor_id FK
    timestamptz fecha_auditoria
    resultado_auditoria resultado
    varchar observaciones "(500)"
    numeric puntaje_academico "(5,2) CHECK 0-30, lo escribe el auditor"
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  ADJUDICACION {
    bigint id PK
    uuid codigo_adjudicacion UK
    bigint decidido_por FK
    bigint postulacion_id FK, UK
    resultado_adjudicacion resultado
    numeric puntaje_final "(5,2)"
    timestamptz fecha_adjudicacion
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  ACTA_ADJUDICACION {
    bigint id PK
    uuid codigo_acta_adjudicacion UK
    bigint convocatoria_id FK
    bigint generada_por FK
    varchar numero UK
    varchar storage_path
    timestamptz generada_en
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  PUBLICACION_RESULTADO {
    bigint id PK
    uuid codigo_publicacion_resultado UK
    bigint publicado_por FK
    bigint convocatoria_id FK, UK
    timestamptz publicado_en
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  BECA {
    bigint id PK
    uuid codigo_beca UK
    bigint convocatoria_id FK
    bigint postulante_id FK
    bigint adjudicacion_id FK, UK
    estado_beca estado
    date fecha_inicio
    date fecha_fin
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  MOVIMIENTO_BECA {
    bigint id PK
    uuid codigo_movimiento_beca UK
    bigint beca_id FK
    bigint beca_reemplazante_id FK
    bigint registrado_por FK
    tipo_movimiento_beca tipo
    date fecha
    text motivo
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  ASISTENCIA {
    bigint id PK
    uuid codigo_asistencia UK
    bigint beca_id FK
    bigint registrado_por FK
    date fecha
    timestamptz hora_registro
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  PLANILLA_ASISTENCIA {
    bigint id PK
    uuid codigo_planilla_asistencia UK
    bigint convocatoria_id FK
    bigint generada_por FK
    date fecha_desde
    date fecha_hasta
    timestamptz generada_en
    varchar storage_path
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  COTEJO_ASISTENCIA {
    bigint id PK
    uuid codigo_cotejo_asistencia UK
    bigint planilla_id FK
    bigint realizado_por FK
    date fecha_cotejo
    int total_registros
    int coincidencias
    int discrepancias
    varchar resultado
    text observaciones
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  COMUNICADO {
    bigint id PK
    uuid codigo_comunicado UK
    bigint convocatoria_id FK
    bigint publicado_por FK
    varchar titulo
    text contenido
    destinatarios_comunicado destinatarios
    timestamptz publicado_en
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  NOTIFICACION {
    bigint id PK
    uuid codigo_notificacion UK
    bigint comunicado_id FK
    bigint postulacion_id FK
    bigint usuario_id FK
    varchar titulo
    text mensaje
    tipo_notificacion tipo
    boolean leida
    timestamptz enviada_en
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  DISPOSITIVO_FCM {
    bigint id PK
    uuid codigo_dispositivo_fcm UK
    bigint usuario_id FK
    varchar token UK
    varchar plataforma
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }

  BITACORA {
    bigint id PK
    uuid codigo_bitacora UK
    bigint usuario_id FK
    varchar accion "(60)"
    varchar entidad "(60)"
    bigint entidad_id
    jsonb detalle
    inet ip
    timestamptz creado_en
    timestamptz actualizado_en
    timestamptz eliminado_en
  }
