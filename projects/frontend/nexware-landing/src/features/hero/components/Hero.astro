---
import PixelN from '@/components/ui/PixelN.astro'
import Button from '@/components/ui/Button.astro'
import Eyebrow from '@/components/ui/Eyebrow.astro'
import { useTranslations, type Lang } from '@/i18n/utils'

interface Props {
  lang: Lang
}

const t = useTranslations(Astro.props.lang)
---

<section id="inicio" class="hero" aria-labelledby="hero-title">
  <div class="inner">
    <div class="copy">
      <Eyebrow>{t('hero.eyebrow')}</Eyebrow>
      <h1 id="hero-title">{t('hero.title')}</h1>
      <p class="tagline">{t('hero.tagline')}</p>
      <p class="text">{t('hero.text')}</p>
      <div class="buttons">
        <Button href="#contacto">{t('hero.cta1')}</Button>
        <Button href="#portafolio" variant="secondary">
          {t('hero.cta2')}
        </Button>
      </div>
    </div>
    <div class="art">
      <PixelN />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding: clamp(48px, 8vw, 112px) clamp(20px, 5vw, 80px);
  }
  /* Rejilla de puntos que se desvanece hacia abajo: refuerza la idea de
     píxeles del logo sin competir con el contenido. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(var(--border) 1.5px, transparent 1.5px);
    background-size: 28px 28px;
    mask-image: linear-gradient(to bottom, #000 0%, transparent 85%);
  }
  .inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
  }
  .copy {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  h1 {
    font-size: clamp(44px, 7vw, 88px);
    line-height: 1.02;
    letter-spacing: -0.04em;
    font-weight: 700;
  }
  .tagline {
    font-size: clamp(22px, 2.6vw, 32px);
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--accent);
  }
  .text {
    max-width: 560px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--soft);
  }
  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
  .art {
    flex: 1 1 320px;
    min-width: 0;
    display: flex;
    justify-content: center;
  }
</style>
