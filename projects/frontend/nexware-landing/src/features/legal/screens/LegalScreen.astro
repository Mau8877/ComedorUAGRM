---
import { render, type CollectionEntry } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Eyebrow from '@/components/ui/Eyebrow.astro'
import { LEGAL_PAGES, homePath } from '@/i18n/routes'
import { formatDate, useTranslations, type Lang } from '@/i18n/utils'

interface Props {
  lang: Lang
  entry: CollectionEntry<'legal'>
}

const { lang, entry } = Astro.props
const t = useTranslations(lang)
const { title, slug, updated } = entry.data
const legalId = LEGAL_PAGES.find((page) => page.slugs[lang] === slug)!.id
const { Content, headings } = await render(entry)
const toc = headings.filter((heading) => heading.depth === 2)
---

<BaseLayout
  {lang}
  {legalId}
  title={`${title} · Nexware`}
  description={t(`seo.${legalId}.description`)}
>
  <div class="legal">
    <div class="inner">
      {toc.length > 0 && (
        <aside class="toc" aria-label={t('legal.toc')}>
          <a class="back" href={homePath(lang)}>
            ← {t('legal.back')}
          </a>
          <Eyebrow>{t('legal.toc')}</Eyebrow>
          <ul>
            {toc.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )}
      <article class="doc">
        <h1>{title}</h1>
        <p class="updated">
          {t('legal.updated')}
          <time datetime={updated.toISOString().slice(0, 10)}>{formatDate(updated, lang)}</time>
        </p>
        <p class="notice" role="note">
          {t('legal.notice')}
        </p>
        <div class="prose">
          <Content />
        </div>
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .legal {
    padding: clamp(40px, 6vw, 80px) clamp(20px, 5vw, 80px);
  }
  .inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: flex-start;
  }
  .toc {
    flex: 0 0 240px;
    position: sticky;
    top: 96px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .toc ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .toc li a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    color: var(--soft);
    text-decoration: none;
  }
  .toc li a:hover {
    color: var(--ink);
  }
  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    color: var(--accent);
    text-decoration: none;
  }
  .doc {
    flex: 1 1 0;
    min-width: 0;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  h1 {
    font-size: clamp(32px, 4.4vw, 52px);
    line-height: 1.08;
    letter-spacing: -0.03em;
    font-weight: 700;
  }
  .updated {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 13px;
    color: var(--soft);
  }
  .updated time {
    margin-left: 0.5ch;
  }
  .notice {
    padding: 14px 16px;
    border-radius: 12px;
    background: var(--tint);
    border: 1px solid var(--border);
    font-size: 15px;
  }
  .prose :global(h2) {
    margin-top: 32px;
    margin-bottom: 8px;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 600;
  }
  .prose :global(p),
  .prose :global(li) {
    font-size: 17px;
    line-height: 1.6;
    color: var(--soft);
  }
  .prose :global(p) {
    margin: 8px 0;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 24px;
    margin: 8px 0;
  }
  .prose :global(a) {
    color: var(--accent);
  }
  .prose :global(strong) {
    color: var(--ink);
  }
  @media (max-width: 860px) {
    .toc {
      display: none;
    }
  }
</style>
