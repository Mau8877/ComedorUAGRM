---
import Button from '@/components/ui/Button.astro'
import { useTranslations, type Lang } from '@/i18n/utils'

interface Props {
  lang: Lang
}

const t = useTranslations(Astro.props.lang)
---

<!--
  Valida en el navegador y envía el mensaje a POST /api/v1/contacto del core
  (mismo origen detrás del proxy), que lo reenvía por correo.
-->
<form
  class="form"
  novalidate
  data-required={t('contact.errorRequired')}
  data-email={t('contact.errorEmail')}
  data-success={t('contact.success')}
  data-sending={t('contact.sending')}
  data-error-send={t('contact.errorSend')}
>
  <!-- Campo trampa contra bots: una persona no lo ve; si llega lleno, el servidor descarta el mensaje. -->
  <div class="trampa" aria-hidden="true">
    <label for="sitioWeb">No lo llenes</label>
    <input id="sitioWeb" name="sitioWeb" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <div class="field">
    <label for="nombre">{t('contact.name')}</label>
    <input
      id="nombre"
      name="nombre"
      type="text"
      autocomplete="name"
      required
      aria-describedby="nombre-error"
    />
    <span id="nombre-error" class="error" role="alert"></span>
  </div>
  <div class="field">
    <label for="correo">{t('contact.emailLabel')}</label>
    <input
      id="correo"
      name="correo"
      type="email"
      autocomplete="email"
      required
      aria-describedby="correo-error"
    />
    <span id="correo-error" class="error" role="alert"></span>
  </div>
  <div class="field">
    <label for="mensaje">{t('contact.message')}</label>
    <textarea
      id="mensaje"
      name="mensaje"
      rows="4"
      required
      aria-describedby="mensaje-error"
    ></textarea>
    <span id="mensaje-error" class="error" role="alert"></span>
  </div>
  <Button type="submit" class="send">
    {t('contact.send')}
  </Button>
  <p class="success" role="status" hidden></p>
  <p class="failure" role="alert" hidden></p>
</form>

<script>
  import { validateField } from '../lib/validate'

  const form = document.querySelector<HTMLFormElement>('.form')
  const success = form?.querySelector<HTMLElement>('.success')
  const failure = form?.querySelector<HTMLElement>('.failure')
  const send = form?.querySelector<HTMLButtonElement>('button[type="submit"]')

  function setError(field: HTMLInputElement | HTMLTextAreaElement, message: string) {
    const output = document.getElementById(`${field.id}-error`)
    if (output) output.textContent = message
    field.setAttribute('aria-invalid', message ? 'true' : 'false')
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    if (!form || !success || !failure) return
    let firstInvalid: HTMLElement | null = null

    form
      .querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
        'input:not([name="sitioWeb"]), textarea'
      )
      .forEach((field) => {
        const error = validateField(field.type, field.value)
        const message =
          error === 'required' ? form.dataset.required : error === 'email' ? form.dataset.email : ''
        setError(field, message ?? '')
        if (error && !firstInvalid) firstInvalid = field
      })

    if (firstInvalid) {
      success.hidden = true
      ;(firstInvalid as HTMLElement).focus()
      return
    }
    success.hidden = true
    failure.hidden = true
    const label = send?.textContent
    if (send) {
      send.disabled = true
      send.textContent = form.dataset.sending ?? ''
    }
    try {
      const data = new FormData(form)
      const response = await fetch('/api/v1/contacto', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          nombre: data.get('nombre'),
          correo: data.get('correo'),
          mensaje: data.get('mensaje'),
          sitioWeb: data.get('sitioWeb'),
        }),
      })
      if (!response.ok) throw new Error(String(response.status))
      success.textContent = form.dataset.success ?? ''
      success.hidden = false
      form.reset()
    } catch {
      failure.textContent = form.dataset.errorSend ?? ''
      failure.hidden = false
    } finally {
      if (send) {
        send.disabled = false
        send.textContent = label ?? ''
      }
    }
  })
</script>

<style>
  .form {
    flex: 1 1 360px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  label {
    font-size: 14px;
    font-weight: 500;
  }
  input,
  textarea {
    width: 100%;
    min-height: 48px;
    padding: 0 14px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--ink);
    font-family: inherit;
    font-size: 16px;
    transition: border-color 0.15s ease;
  }
  input:hover,
  textarea:hover {
    border-color: var(--soft);
  }
  textarea {
    padding: 12px 14px;
    resize: vertical;
  }
  input[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    border-color: var(--accent);
    outline: 1px solid var(--accent);
  }
  .error {
    font-size: 14px;
    color: var(--soft);
  }
  .error:not(:empty)::before {
    content: '⚠ ';
    color: var(--accent);
  }
  .form :global(.send) {
    align-self: flex-start;
  }
  .trampa {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .failure {
    padding: 12px 16px;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--accent);
    font-size: 15px;
  }
  .success {
    padding: 12px 16px;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--accent);
    font-size: 15px;
  }
</style>
