---
import { useTranslations, type Lang } from '@/i18n/utils'

interface Props {
  lang: Lang
}

const t = useTranslations(Astro.props.lang)
---

<button
  type="button"
  class="theme-toggle"
  data-to-light={t('nav.theme.toLight')}
  data-to-dark={t('nav.theme.toDark')}
  aria-label={t('nav.theme.toDark')}
>
  <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
  <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<script>
  // El tema inicial ya lo pone el script en línea del <head> (BaseLayout);
  // acá solo se alterna y se guarda la elección.
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle')

  function sync() {
    if (!button) return
    const dark = document.documentElement.dataset.theme === 'dark'
    button.setAttribute('aria-label', (dark ? button.dataset.toLight : button.dataset.toDark) ?? '')
  }

  sync()
  button?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
    document.documentElement.dataset.theme = next
    try {
      localStorage.setItem('theme', next)
    } catch {
      // Sin almacenamiento disponible: el tema solo dura esta visita.
    }
    sync()
  })
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .theme-toggle:hover {
    border-color: var(--accent);
  }
  svg {
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .icon-sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }
  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }
</style>
