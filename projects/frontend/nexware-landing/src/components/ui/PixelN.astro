---
// Cuadrícula decorativa de 5x5 con el patrón de la N.
const cells = Array.from({ length: 25 }, (_, i) => {
  const r = Math.floor(i / 5)
  const c = i % 5
  const on = c === 0 || c === 4 || r === c
  const center = r === 2 && c === 2
  return { on, center }
})
---

<div class="pixel-n" aria-hidden="true">
  {cells.map((cell) => (
    <div class="cell" class:list={{ on: cell.on, center: cell.center }}></div>
  ))}
</div>

<style>
  .pixel-n {
    width: min(420px, 100%);
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
  }
  .cell {
    aspect-ratio: 1 / 1;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .cell.on {
    background: var(--ink);
    border-color: transparent;
  }
  .cell.center {
    background: var(--accent);
    border-color: transparent;
    animation: blink 2.4s ease-in-out infinite;
  }
  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cell.center {
      animation: none;
    }
  }
</style>
