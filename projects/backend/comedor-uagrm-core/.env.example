# ==========================================
# BACKEND - ENVIRONMENT CONFIGURATION
# ==========================================

# Base de datos (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/comedor_uagrm_db
SPRING_DATASOURCE_USERNAME=comedor_uagrm_admin
SPRING_DATASOURCE_PASSWORD=comedor_uagrm_local_pass_123

# Caché (Redis)
SPRING_DATA_REDIS_HOST=localhost

# Almacenamiento (MinIO)
MINIO_URL=http://localhost:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_local_pass_123

# CORS (orígenes permitidos para llamar a la API desde el navegador)
# Ya trae un default en application.properties (http://localhost:5173,http://localhost);
# solo hace falta descomentar/editar esto si agregás otro origen (otro puerto, un dominio de producción, etc.)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# Autenticación: secreto con el que el backend firma sus JWT (HS256).
# Obligatorio y de al menos 32 caracteres; generar uno con:  openssl rand -base64 48
JWT_SECRET=
# Opcionales (valores por defecto: emisor comedor-uagrm, acceso 15 min, refresh 7 días)
# JWT_ISSUER=comedor-uagrm
# JWT_ACCESS_TTL_MINUTES=15
# JWT_REFRESH_TTL_DAYS=7

# Cookies de sesión del cliente web: poner en true cuando el backend se sirva por HTTPS (producción).
# COOKIE_SECURE=false

# Correo (recuperación de contraseña). Fuera de docker, Mailpit escucha en localhost:1025
# (docker compose up mailpit) y su bandeja está en http://localhost:8025.
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=false
# MAIL_SMTP_STARTTLS=false
# MAIL_FROM=no-responder@comedoru.local
# URL del portal web: el enlace del correo abre {FRONTEND_URL}/restablecer-contrasena?token=...
# FRONTEND_URL=http://localhost
# RESET_TTL_MINUTES=60

# Archivos (MinIO, CU07): la direccion con la que el NAVEGADOR llega a MinIO. Las URL temporales con las
# que el administrador abre un documento se firman con este host. Por defecto: http://localhost:9000
# MINIO_PUBLIC_URL=http://localhost:9000

# Notificaciones push (Firebase Cloud Messaging, CU-EXTRA-01).
# Ruta al JSON de la cuenta de servicio de Firebase (secreto, nunca se versiona).
# En Docker ya apunta a /run/secrets/firebase-sa.json (la carpeta secrets/ montada), así que
# no hace falta definirla. Fuera de Docker: la ruta local del archivo, por ejemplo
# FIREBASE_CREDENTIALS_PATH=./secrets/firebase-sa.json
# Sin archivo el backend arranca igual y el push queda solo en el log. Ver secrets/README.md.
# FIREBASE_CREDENTIALS_PATH=
