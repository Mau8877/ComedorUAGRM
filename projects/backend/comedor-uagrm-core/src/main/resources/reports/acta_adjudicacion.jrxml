<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="acta_adjudicacion" language="java" columnCount="1" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="24" bottomMargin="24" whenNoDataType="AllSectionsNoDetail">
	<!--ESTILOS_UAGRM-->
	<parameter name="TITULO" class="java.lang.String"/>
	<parameter name="NUMERO" class="java.lang.String"/>
	<parameter name="CONVOCATORIA" class="java.lang.String"/>
	<parameter name="GESTION" class="java.lang.String"/>
	<parameter name="APERTURA" class="java.lang.String"/>
	<parameter name="CIERRE" class="java.lang.String"/>
	<parameter name="CUPOS" class="java.lang.String"/>
	<parameter name="MINIMO" class="java.lang.String"/>
	<parameter name="GENERADO_EN" class="java.lang.String"/>
	<parameter name="GENERADO_POR" class="java.lang.String"/>
	<parameter name="RESUMEN" class="java.lang.String"/>
	<parameter name="HAY_ADJUDICADOS" class="java.lang.Boolean"/>
	<field name="orden" class="java.lang.String"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="ci" class="java.lang.String"/>
	<field name="carrera" class="java.lang.String"/>
	<field name="puntaje" class="java.lang.String"/>
	<title height="154">
		<element kind="staticText" style="Banda" x="0" y="0" width="555" height="58"><text><![CDATA[ ]]></text></element>
		<element kind="staticText" style="Franja" x="0" y="62" width="555" height="1"><text><![CDATA[ ]]></text></element>
		<element kind="image" scaleImage="RetainShape" hImageAlign="Left" vImageAlign="Middle" x="0" y="2" width="56" height="56"><expression><![CDATA["reports/logo_dubss.png"]]></expression></element>
		<element kind="staticText" style="FranjaRoja" x="0" y="62" width="90" height="3"><text><![CDATA[ ]]></text></element>
		<element kind="staticText" style="Institucion" mode="Transparent" x="68" y="12" width="487" height="11"><text><![CDATA[DIRECCIÓN UNIVERSITARIA DE BIENESTAR SOCIAL Y SALUD   ·   UAGRM   ·   BECA COMEDOR]]></text></element>
		<element kind="textField" style="TituloDoc" x="68" y="22" width="487" height="28"><expression><![CDATA[$P{TITULO}]]></expression></element>
		<element kind="staticText" style="Tarjeta" x="0" y="70" width="555" height="56"><text><![CDATA[ ]]></text></element>
		<element kind="textField" style="MetaValor" x="16" y="76" width="330" height="13"><expression><![CDATA["Acta N.º " + $P{NUMERO}]]></expression></element>
		<element kind="textField" style="MetaValor" x="16" y="92" width="330" height="13"><expression><![CDATA["Convocatoria: " + $P{CONVOCATORIA} + "  (gestión " + $P{GESTION} + ")"]]></expression></element>
		<element kind="textField" style="MetaValor" x="350" y="76" width="195" height="13"><expression><![CDATA["Apertura: " + $P{APERTURA}]]></expression></element>
		<element kind="textField" style="MetaValor" x="350" y="92" width="195" height="13"><expression><![CDATA["Cierre: " + $P{CIERRE}]]></expression></element>
		<element kind="textField" style="MetaValor" x="16" y="108" width="330" height="13"><expression><![CDATA["Cupos: " + $P{CUPOS} + "    Puntaje mínimo: " + $P{MINIMO}]]></expression></element>
		<element kind="textField" style="Seccion" x="0" y="132" width="555" height="16"><expression><![CDATA[$P{RESUMEN}]]></expression></element>
	</title>
	<columnHeader height="22">
		<element kind="staticText" style="Cabecera" x="0" y="0" width="40" height="22" hTextAlign="Center"><text><![CDATA[N.º]]></text></element>
		<element kind="staticText" style="Cabecera" x="40" y="0" width="195" height="22"><text><![CDATA[Nombre y apellido]]></text></element>
		<element kind="staticText" style="Cabecera" x="235" y="0" width="80" height="22"><text><![CDATA[CI]]></text></element>
		<element kind="staticText" style="Cabecera" x="315" y="0" width="170" height="22"><text><![CDATA[Carrera]]></text></element>
		<element kind="staticText" style="Cabecera" x="485" y="0" width="70" height="22" hTextAlign="Right"><text><![CDATA[Puntaje final]]></text></element>
	</columnHeader>
	<detail>
		<band height="18">
			<element kind="textField" style="Celda" textAdjust="StretchHeight" x="0" y="0" width="40" height="18" hTextAlign="Center"><expression><![CDATA[$F{orden}]]></expression></element>
			<element kind="textField" style="Celda" textAdjust="StretchHeight" x="40" y="0" width="195" height="18"><expression><![CDATA[$F{nombre}]]></expression></element>
			<element kind="textField" style="Celda" textAdjust="StretchHeight" x="235" y="0" width="80" height="18"><expression><![CDATA[$F{ci}]]></expression></element>
			<element kind="textField" style="Celda" textAdjust="StretchHeight" x="315" y="0" width="170" height="18"><expression><![CDATA[$F{carrera}]]></expression></element>
			<element kind="textField" style="Celda" textAdjust="StretchHeight" x="485" y="0" width="70" height="18" hTextAlign="Right"><expression><![CDATA[$F{puntaje}]]></expression></element>
		</band>
	</detail>
	<summary height="140">
		<element kind="staticText" style="MetaValor" x="0" y="6" width="555" height="16" italic="true" hTextAlign="Center">
			<printWhenExpression><![CDATA[!$P{HAY_ADJUDICADOS}]]></printWhenExpression>
			<text><![CDATA[Sin adjudicados]]></text>
		</element>
		<element kind="textField" style="MetaValor" x="0" y="30" width="555" height="12"><expression><![CDATA["Generada por: " + $P{GENERADO_POR}]]></expression></element>
		<element kind="line" x="40" y="104" width="200" height="1" forecolor="#2A3964"/>
		<element kind="line" x="315" y="104" width="200" height="1" forecolor="#2A3964"/>
		<element kind="staticText" style="Negrita" x="40" y="108" width="200" height="12" hTextAlign="Center"><text><![CDATA[Administrador DUBSS]]></text></element>
		<element kind="staticText" style="Negrita" x="315" y="108" width="200" height="12" hTextAlign="Center"><text><![CDATA[Autoridad DUBSS]]></text></element>
	</summary>
	<pageFooter height="22">
		<element kind="line" x="0" y="2" width="555" height="1" forecolor="#D5DBE5"/>
		<element kind="textField" style="Pie" x="0" y="6" width="435" height="12">
			<expression><![CDATA["Generado el " + $P{GENERADO_EN} + " por " + $P{GENERADO_POR}]]></expression>
		</element>
		<element kind="textField" style="Pie" x="435" y="6" width="100" height="12" hTextAlign="Right">
			<expression><![CDATA["Página " + $V{PAGE_NUMBER}]]></expression>
		</element>
		<element kind="textField" style="Pie" evaluationTime="Report" x="535" y="6" width="20" height="12" hTextAlign="Left">
			<expression><![CDATA[" de " + $V{PAGE_NUMBER}]]></expression>
		</element>
	</pageFooter>
</jasperReport>
