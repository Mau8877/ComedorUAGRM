<?xml version="1.0" encoding="UTF-8"?>
<!-- Acta de adjudicacion (CU08). Formato JRXML de JasperReports 7 (elementos con `kind`, sin namespace XML).
     Los datos llegan ya formateados (texto) desde ActaPdfService; la plantilla solo los coloca. Solo lleva
     adjudicados: nunca no adjudicados, motivos, correos ni datos socioeconomicos. El encabezado, los rotulos de
     firma y el formato oficial estan por definir con la DUBSS. -->
<jasperReport name="acta_adjudicacion" language="java" columnCount="1" pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20" topMargin="30" bottomMargin="30"
              whenNoDataType="AllSectionsNoDetail">
	<style name="base" default="true" fontName="SansSerif" fontSize="9"
	       pdfFontName="Helvetica" pdfEncoding="Cp1252" pdfEmbedded="false"/>
	<parameter name="TITULO" class="java.lang.String"/>
	<parameter name="NUMERO" class="java.lang.String"/>
	<parameter name="CONVOCATORIA" class="java.lang.String"/>
	<parameter name="GESTION" class="java.lang.String"/>
	<parameter name="APERTURA" class="java.lang.String"/>
	<parameter name="CIERRE" class="java.lang.String"/>
	<parameter name="CUPOS" class="java.lang.String"/>
	<parameter name="MINIMO" class="java.lang.String"/>
	<parameter name="GENERADO_EN" class="java.lang.String"/>
	<parameter name="GENERADO_POR" class="java.lang.String"/>
	<parameter name="RESUMEN" class="java.lang.String"/>
	<parameter name="HAY_ADJUDICADOS" class="java.lang.Boolean"/>
	<field name="orden" class="java.lang.String"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="ci" class="java.lang.String"/>
	<field name="carrera" class="java.lang.String"/>
	<field name="puntaje" class="java.lang.String"/>
	<title height="170">
		<element kind="staticText" x="0" y="0" width="555" height="14" fontSize="10.0" bold="true"
		         pdfFontName="Helvetica-Bold" hTextAlign="Center">
			<text><![CDATA[UAGRM – Universidad Autónoma Gabriel René Moreno]]></text>
		</element>
		<element kind="staticText" x="0" y="15" width="555" height="12" hTextAlign="Center">
			<text><![CDATA[DUBSS]]></text>
		</element>
		<element kind="textField" x="0" y="36" width="555" height="22" fontSize="15.0" bold="true"
		         pdfFontName="Helvetica-Bold" hTextAlign="Center">
			<expression><![CDATA[$P{TITULO}]]></expression>
		</element>
		<element kind="textField" x="0" y="60" width="555" height="16" fontSize="11.0" bold="true"
		         pdfFontName="Helvetica-Bold" hTextAlign="Center">
			<expression><![CDATA["N.º " + $P{NUMERO}]]></expression>
		</element>
		<element kind="textField" x="0" y="86" width="555" height="16" fontSize="10.0" bold="true"
		         pdfFontName="Helvetica-Bold">
			<expression><![CDATA["Convocatoria: " + $P{CONVOCATORIA} + "  (gestión " + $P{GESTION} + ")"]]></expression>
		</element>
		<element kind="textField" x="0" y="103" width="555" height="12">
			<expression><![CDATA["Apertura: " + $P{APERTURA} + "    Cierre: " + $P{CIERRE}]]></expression>
		</element>
		<element kind="textField" x="0" y="116" width="555" height="12">
			<expression><![CDATA["Cupos: " + $P{CUPOS} + "    Puntaje mínimo: " + $P{MINIMO}]]></expression>
		</element>
		<element kind="textField" x="0" y="129" width="555" height="12">
			<expression><![CDATA["Generada el " + $P{GENERADO_EN}]]></expression>
		</element>
		<element kind="textField" x="0" y="148" width="555" height="14" fontSize="10.0" bold="true"
		         pdfFontName="Helvetica-Bold">
			<expression><![CDATA[$P{RESUMEN}]]></expression>
		</element>
	</title>
	<columnHeader height="20">
		<element kind="staticText" mode="Opaque" backcolor="#2A3964" forecolor="#FFFFFF" x="0" y="0" width="35"
		         height="20" bold="true" pdfFontName="Helvetica-Bold" vTextAlign="Middle">
			<box leftPadding="3"/>
			<text><![CDATA[N.º]]></text>
		</element>
		<element kind="staticText" mode="Opaque" backcolor="#2A3964" forecolor="#FFFFFF" x="35" y="0" width="195"
		         height="20" bold="true" pdfFontName="Helvetica-Bold" vTextAlign="Middle">
			<box leftPadding="3"/>
			<text><![CDATA[Nombre y apellido]]></text>
		</element>
		<element kind="staticText" mode="Opaque" backcolor="#2A3964" forecolor="#FFFFFF" x="230" y="0" width="80"
		         height="20" bold="true" pdfFontName="Helvetica-Bold" vTextAlign="Middle">
			<box leftPadding="3"/>
			<text><![CDATA[CI]]></text>
		</element>
		<element kind="staticText" mode="Opaque" backcolor="#2A3964" forecolor="#FFFFFF" x="310" y="0" width="175"
		         height="20" bold="true" pdfFontName="Helvetica-Bold" vTextAlign="Middle">
			<box leftPadding="3"/>
			<text><![CDATA[Carrera]]></text>
		</element>
		<element kind="staticText" mode="Opaque" backcolor="#2A3964" forecolor="#FFFFFF" x="485" y="0" width="70"
		         height="20" bold="true" pdfFontName="Helvetica-Bold" vTextAlign="Middle">
			<box leftPadding="3"/>
			<text><![CDATA[Puntaje final]]></text>
		</element>
	</columnHeader>
	<detail>
		<band height="16">
			<element kind="textField" x="0" y="0" width="35" height="16" textAdjust="StretchHeight">
				<box leftPadding="3"/>
				<expression><![CDATA[$F{orden}]]></expression>
			</element>
			<element kind="textField" x="35" y="0" width="195" height="16" textAdjust="StretchHeight">
				<box leftPadding="3"/>
				<expression><![CDATA[$F{nombre}]]></expression>
			</element>
			<element kind="textField" x="230" y="0" width="80" height="16" textAdjust="StretchHeight">
				<box leftPadding="3"/>
				<expression><![CDATA[$F{ci}]]></expression>
			</element>
			<element kind="textField" x="310" y="0" width="175" height="16" textAdjust="StretchHeight">
				<box leftPadding="3"/>
				<expression><![CDATA[$F{carrera}]]></expression>
			</element>
			<element kind="textField" x="485" y="0" width="70" height="16" textAdjust="StretchHeight">
				<box leftPadding="3"/>
				<expression><![CDATA[$F{puntaje}]]></expression>
			</element>
		</band>
	</detail>
	<summary height="140">
		<element kind="staticText" x="0" y="4" width="555" height="16" fontSize="10.0" italic="true"
		         hTextAlign="Center">
			<printWhenExpression><![CDATA[!$P{HAY_ADJUDICADOS}]]></printWhenExpression>
			<text><![CDATA[Sin adjudicados]]></text>
		</element>
		<element kind="textField" x="0" y="36" width="555" height="12">
			<expression><![CDATA["Generada por: " + $P{GENERADO_POR}]]></expression>
		</element>
		<element kind="line" x="40" y="112" width="200" height="1"/>
		<element kind="line" x="315" y="112" width="200" height="1"/>
		<element kind="staticText" x="40" y="116" width="200" height="12" hTextAlign="Center">
			<text><![CDATA[Administrador DUBSS]]></text>
		</element>
		<element kind="staticText" x="315" y="116" width="200" height="12" hTextAlign="Center">
			<text><![CDATA[Autoridad DUBSS]]></text>
		</element>
	</summary>
	<pageFooter height="16">
		<element kind="textField" x="0" y="2" width="515" height="12" fontSize="8.0" hTextAlign="Right">
			<expression><![CDATA["Página " + $V{PAGE_NUMBER}]]></expression>
		</element>
		<element kind="textField" evaluationTime="Report" x="515" y="2" width="40" height="12" fontSize="8.0"
		         hTextAlign="Left">
			<expression><![CDATA[" de " + $V{PAGE_NUMBER}]]></expression>
		</element>
	</pageFooter>
</jasperReport>
