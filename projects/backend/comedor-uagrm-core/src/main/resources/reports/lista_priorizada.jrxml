<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="lista_priorizada" language="java" columnCount="1" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="24" bottomMargin="24" whenNoDataType="NoPages">
	<!--ESTILOS_UAGRM-->
	<parameter name="CONVOCATORIA" class="java.lang.String"/>
	<parameter name="GESTION" class="java.lang.String"/>
	<parameter name="CARRERA" class="java.lang.String"/>
	<parameter name="BUSQUEDA" class="java.lang.String"/>
	<parameter name="GENERADO_EN" class="java.lang.String"/>
	<parameter name="GENERADO_POR" class="java.lang.String"/>
	<parameter name="TOTAL" class="java.lang.String"/>
	<field name="posicion" class="java.lang.String"/>
	<field name="postulante" class="java.lang.String"/>
	<field name="ci" class="java.lang.String"/>
	<field name="carrera" class="java.lang.String"/>
	<field name="puntaje" class="java.lang.String"/>
	<field name="fechaCalculo" class="java.lang.String"/>
	<title height="122">
		<element kind="staticText" style="Banda" x="0" y="0" width="555" height="58"><text><![CDATA[ ]]></text></element>
		<element kind="staticText" style="Franja" x="0" y="62" width="555" height="1"><text><![CDATA[ ]]></text></element>
		<element kind="image" scaleImage="RetainShape" hImageAlign="Left" vImageAlign="Middle" x="0" y="2" width="56" height="56"><expression><![CDATA["reports/logo_dubss.png"]]></expression></element>
		<element kind="staticText" style="FranjaRoja" x="0" y="62" width="90" height="3"><text><![CDATA[ ]]></text></element>
		<element kind="staticText" style="Institucion" mode="Transparent" x="68" y="12" width="487" height="11"><text><![CDATA[DIRECCIÓN UNIVERSITARIA DE BIENESTAR SOCIAL Y SALUD   ·   UAGRM   ·   BECA COMEDOR]]></text></element>
		<element kind="staticText" style="TituloDoc" x="68" y="22" width="487" height="28"><text><![CDATA[Lista priorizada de postulantes]]></text></element>
		<element kind="staticText" style="Tarjeta" x="0" y="70" width="555" height="40"><text><![CDATA[ ]]></text></element>
		<element kind="textField" style="MetaValor" x="16" y="76" width="320" height="13"><expression><![CDATA["Convocatoria: " + $P{CONVOCATORIA} + "  (gestión " + $P{GESTION} + ")"]]></expression></element>
		<element kind="textField" style="MetaValor" x="16" y="92" width="320" height="13"><expression><![CDATA["Carrera: " + $P{CARRERA}]]></expression></element>
		<element kind="textField" style="MetaValor" x="350" y="76" width="195" height="13"><expression><![CDATA["Postulaciones en la lista: " + $P{TOTAL}]]></expression></element>
		<element kind="textField" style="MetaValor" x="350" y="92" width="195" height="13"><expression><![CDATA["Búsqueda: " + $P{BUSQUEDA}]]></expression></element>
	</title>
	<columnHeader height="22">
		<element kind="staticText" style="Cabecera" x="0" y="0" width="40" height="22" hTextAlign="Center"><text><![CDATA[#]]></text></element>
		<element kind="staticText" style="Cabecera" x="40" y="0" width="185" height="22"><text><![CDATA[Postulante]]></text></element>
		<element kind="staticText" style="Cabecera" x="225" y="0" width="75" height="22"><text><![CDATA[CI]]></text></element>
		<element kind="staticText" style="Cabecera" x="300" y="0" width="140" height="22"><text><![CDATA[Carrera]]></text></element>
		<element kind="staticText" style="Cabecera" x="440" y="0" width="55" height="22" hTextAlign="Right"><text><![CDATA[Puntaje]]></text></element>
		<element kind="staticText" style="Cabecera" x="495" y="0" width="60" height="22" hTextAlign="Center"><text><![CDATA[Calculado]]></text></element>
	</columnHeader>
	<detail>
		<band height="18">
			<element kind="textField" style="Celda" textAdjust="StretchHeight" x="0" y="0" width="40" height="18" hTextAlign="Center"><expression><![CDATA[$F{posicion}]]></expression></element>
			<element kind="textField" style="Celda" textAdjust="StretchHeight" x="40" y="0" width="185" height="18"><expression><![CDATA[$F{postulante}]]></expression></element>
			<element kind="textField" style="Celda" textAdjust="StretchHeight" x="225" y="0" width="75" height="18"><expression><![CDATA[$F{ci}]]></expression></element>
			<element kind="textField" style="Celda" textAdjust="StretchHeight" x="300" y="0" width="140" height="18"><expression><![CDATA[$F{carrera}]]></expression></element>
			<element kind="textField" style="Celda" textAdjust="StretchHeight" x="440" y="0" width="55" height="18" hTextAlign="Right"><expression><![CDATA[$F{puntaje}]]></expression></element>
			<element kind="textField" style="Celda" textAdjust="StretchHeight" x="495" y="0" width="60" height="18" hTextAlign="Center"><expression><![CDATA[$F{fechaCalculo}]]></expression></element>
		</band>
	</detail>
	<pageFooter height="22">
		<element kind="line" x="0" y="2" width="555" height="1" forecolor="#D5DBE5"/>
		<element kind="textField" style="Pie" x="0" y="6" width="435" height="12">
			<expression><![CDATA["Generado el " + $P{GENERADO_EN} + " por " + $P{GENERADO_POR}]]></expression>
		</element>
		<element kind="textField" style="Pie" x="435" y="6" width="100" height="12" hTextAlign="Right">
			<expression><![CDATA["Página " + $V{PAGE_NUMBER}]]></expression>
		</element>
		<element kind="textField" style="Pie" evaluationTime="Report" x="535" y="6" width="20" height="12" hTextAlign="Left">
			<expression><![CDATA[" de " + $V{PAGE_NUMBER}]]></expression>
		</element>
	</pageFooter>
</jasperReport>
