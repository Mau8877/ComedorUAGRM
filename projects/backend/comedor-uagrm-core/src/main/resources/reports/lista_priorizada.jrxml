<?xml version="1.0" encoding="UTF-8"?>
<!-- Lista priorizada de postulantes (CU06). Formato JRXML de JasperReports 7 (elementos con `kind`,
     sin namespace XML). Los datos llegan ya formateados (texto) desde ListaPriorizadaDataSource;
     la plantilla solo los coloca. Sin datos socioeconomicos. -->
<jasperReport name="lista_priorizada" language="java" columnCount="1" pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20" topMargin="30" bottomMargin="30"
              whenNoDataType="NoPages">
	<style name="base" default="true" fontName="SansSerif" fontSize="9"
	       pdfFontName="Helvetica" pdfEncoding="Cp1252" pdfEmbedded="false"/>
	<parameter name="CONVOCATORIA" class="java.lang.String"/>
	<parameter name="GESTION" class="java.lang.String"/>
	<parameter name="CARRERA" class="java.lang.String"/>
	<parameter name="BUSQUEDA" class="java.lang.String"/>
	<parameter name="GENERADO_EN" class="java.lang.String"/>
	<parameter name="GENERADO_POR" class="java.lang.String"/>
	<parameter name="TOTAL" class="java.lang.String"/>
	<field name="posicion" class="java.lang.String"/>
	<field name="postulante" class="java.lang.String"/>
	<field name="ci" class="java.lang.String"/>
	<field name="carrera" class="java.lang.String"/>
	<field name="puntaje" class="java.lang.String"/>
	<field name="fechaCalculo" class="java.lang.String"/>
	<title height="96">
		<element kind="staticText" x="0" y="0" width="555" height="22" fontSize="15.0" bold="true"
		         pdfFontName="Helvetica-Bold">
			<text><![CDATA[Lista priorizada de postulantes]]></text>
		</element>
		<element kind="textField" x="0" y="26" width="555" height="14" fontSize="10.0" bold="true"
		         pdfFontName="Helvetica-Bold">
			<expression><![CDATA["Convocatoria: " + $P{CONVOCATORIA} + "  (gestión " + $P{GESTION} + ")"]]></expression>
		</element>
		<element kind="textField" x="0" y="42" width="555" height="12">
			<expression><![CDATA["Carrera: " + $P{CARRERA}]]></expression>
		</element>
		<element kind="textField" x="0" y="54" width="555" height="12">
			<expression><![CDATA["Búsqueda: " + $P{BUSQUEDA}]]></expression>
		</element>
		<element kind="textField" x="0" y="66" width="555" height="12">
			<expression><![CDATA["Postulaciones en la lista: " + $P{TOTAL}]]></expression>
		</element>
		<element kind="textField" x="0" y="78" width="555" height="12">
			<expression><![CDATA["Generado el " + $P{GENERADO_EN} + " por " + $P{GENERADO_POR}]]></expression>
		</element>
	</title>
	<columnHeader height="20">
		<element kind="staticText" mode="Opaque" backcolor="#2A3964" forecolor="#FFFFFF" x="0" y="0" width="40"
		         height="20" bold="true" pdfFontName="Helvetica-Bold" vTextAlign="Middle">
			<box leftPadding="3"/>
			<text><![CDATA[#]]></text>
		</element>
		<element kind="staticText" mode="Opaque" backcolor="#2A3964" forecolor="#FFFFFF" x="40" y="0" width="190"
		         height="20" bold="true" pdfFontName="Helvetica-Bold" vTextAlign="Middle">
			<box leftPadding="3"/>
			<text><![CDATA[Postulante]]></text>
		</element>
		<element kind="staticText" mode="Opaque" backcolor="#2A3964" forecolor="#FFFFFF" x="230" y="0" width="75"
		         height="20" bold="true" pdfFontName="Helvetica-Bold" vTextAlign="Middle">
			<box leftPadding="3"/>
			<text><![CDATA[CI]]></text>
		</element>
		<element kind="staticText" mode="Opaque" backcolor="#2A3964" forecolor="#FFFFFF" x="305" y="0" width="140"
		         height="20" bold="true" pdfFontName="Helvetica-Bold" vTextAlign="Middle">
			<box leftPadding="3"/>
			<text><![CDATA[Carrera]]></text>
		</element>
		<element kind="staticText" mode="Opaque" backcolor="#2A3964" forecolor="#FFFFFF" x="445" y="0" width="50"
		         height="20" bold="true" pdfFontName="Helvetica-Bold" vTextAlign="Middle">
			<box leftPadding="3"/>
			<text><![CDATA[Puntaje]]></text>
		</element>
		<element kind="staticText" mode="Opaque" backcolor="#2A3964" forecolor="#FFFFFF" x="495" y="0" width="60"
		         height="20" bold="true" pdfFontName="Helvetica-Bold" vTextAlign="Middle">
			<box leftPadding="3"/>
			<text><![CDATA[Calculado]]></text>
		</element>
	</columnHeader>
	<detail>
		<band height="16">
			<element kind="textField" x="0" y="0" width="40" height="16" textAdjust="StretchHeight">
			<box leftPadding="3"/>
				<expression><![CDATA[$F{posicion}]]></expression>
			</element>
			<element kind="textField" x="40" y="0" width="190" height="16" textAdjust="StretchHeight">
			<box leftPadding="3"/>
				<expression><![CDATA[$F{postulante}]]></expression>
			</element>
			<element kind="textField" x="230" y="0" width="75" height="16" textAdjust="StretchHeight">
			<box leftPadding="3"/>
				<expression><![CDATA[$F{ci}]]></expression>
			</element>
			<element kind="textField" x="305" y="0" width="140" height="16" textAdjust="StretchHeight">
			<box leftPadding="3"/>
				<expression><![CDATA[$F{carrera}]]></expression>
			</element>
			<element kind="textField" x="445" y="0" width="50" height="16" textAdjust="StretchHeight">
			<box leftPadding="3"/>
				<expression><![CDATA[$F{puntaje}]]></expression>
			</element>
			<element kind="textField" x="495" y="0" width="60" height="16" textAdjust="StretchHeight">
			<box leftPadding="3"/>
				<expression><![CDATA[$F{fechaCalculo}]]></expression>
			</element>
		</band>
	</detail>
	<pageFooter height="16">
		<element kind="textField" x="0" y="2" width="515" height="12" fontSize="8.0" hTextAlign="Right">
			<expression><![CDATA["Página " + $V{PAGE_NUMBER}]]></expression>
		</element>
		<element kind="textField" evaluationTime="Report" x="515" y="2" width="40" height="12" fontSize="8.0"
		         hTextAlign="Left">
			<expression><![CDATA[" de " + $V{PAGE_NUMBER}]]></expression>
		</element>
	</pageFooter>
</jasperReport>
